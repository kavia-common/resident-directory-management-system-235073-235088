# Backend service configuration
# NOTE: Do not put real secrets here. Copy to .env and fill values.

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# Postgres (provided by platform for the database container)
POSTGRES_URL=postgresql://user:password@host:5432/dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname
POSTGRES_PORT=5432

# Auth
# Generate a long random secret. Used to sign JWTs.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# DEV ONLY: set to 1 to allow backend to boot without JWT_SECRET (uses a fixed insecure fallback).
# Never enable this in production.
ALLOW_INSECURE_DEV_JWT=0
